# ============================================================
# Template .env PRODUKSI — salin menjadi `.env` di server, lalu
# isi semua nilai <...>. JANGAN memakai nilai dari .env lokal.
# Setelah diisi: php artisan key:generate --force
# Checklist lengkap: lihat DEPLOYMENT.md
# ============================================================

APP_NAME="Inventaris ATK BKD"
APP_ENV=production
APP_KEY=            # diisi otomatis oleh: php artisan key:generate --force
APP_DEBUG=false     # WAJIB false — true membocorkan stack trace & kredensial
APP_URL=https://<domain-anda>

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily   # rotasi harian agar log tidak membengkak
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nama_database>
DB_USERNAME=<user_khusus_aplikasi>   # jangan pakai root
DB_PASSWORD=<password_kuat>

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true   # cookie hanya lewat HTTPS

QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

# SMTP pengirim — alamat & password aplikasi dapat juga diatur dari
# menu Pengaturan > Email (tersimpan terenkripsi di database).
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<email_pengirim>
MAIL_PASSWORD=<app_password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<email_pengirim>
MAIL_FROM_NAME="${APP_NAME}"

# Path mysqldump bila tidak ada di PATH (dipakai `php artisan db:backup`).
# Gunakan garis miring biasa (/) — backslash membuat .env gagal diparsing.
# MYSQLDUMP_PATH="C:/laragon/bin/mysql/mysql-8.0.30-winx64/bin/mysqldump.exe"
